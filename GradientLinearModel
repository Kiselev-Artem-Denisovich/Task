class GradientLinearModel():
    def __init__(self, learning_rate = 0.01, epochs=1000, trig=False, batch_size=32, 
                 regularization='elastic', alpha=0.1):
        self.learning_rate = learning_rate
        self.w = None
        self.b = None
        self.epochs = epochs
        self.trig = trig
        self.batch_size = batch_size
        self.regularization = regularization
        self.alpha = alpha

    def fit(self, X, y):
        m, n = X.shape
        self.w = np.random.randn(n) * 0.01
        self.b = np.random.randn(1) 

        X = np.asarray(X, dtype=np.float32)
        y = np.asarray(y, dtype=np.float32)

        loss_last = 50000
        loss_list = []
        
        batch_size = self.batch_size

        for epoch in range(self.epochs):
            indices = np.random.permutation(m)

            batch_size = self.batch_size

            for i in range(0, m, batch_size):
                end_idx = min(i + batch_size, m)
                X_batch = X[indices[i:end_idx]] 

                batch_size_actual = len(X_batch)

                # Сами расчеты градиентного спуска
                y_pred = X_batch @ self.w + self.b
                errors = y_pred - y[indices[i:end_idx]]

                dw = X_batch.T @ errors / batch_size_actual
                db = np.sum(errors) / batch_size_actual

                # Реализациярегулизации
                if self.regularization == 'l2':
                    dw += (self.alpha) * self.w
                elif self.regularization == 'l1':
                    dw += (self.alpha) * np.sign(self.w)
                elif self.regularization == 'elastic':
                    l1_term = (self.alpha * 0.5) * np.sign(self.w)
                    l2_term = (self.alpha * 0.5) * self.w 
                    dw += (l1_term + l2_term)
                    
                # Градиент по весам 
                self.w -= dw * self.learning_rate
                    # Градиент по смещению
                self.b -= db * self.learning_rate

            # Сохраняю список ошибок для истории графика и для сравнения
            # Чтобы заранее остановить обучение и поиск w и b
            current_loss = np.mean((X @ self.w + self.b - y) ** 2)
            loss_list.append(current_loss)
            if abs(loss_last - current_loss) <= 1e-6:
                break
                
            # Показываю обучение, если заранее написать True
            if epoch % 100 == 0 and self.trig:
                print(f'Epoch: {epoch}, w: {self.w}, b: {self.b}, MSE: {round(current_loss, 5)}, Loss: {np.sum(errors)}')
            
            loss_last = current_loss

    def predict(self, X):
        X = np.asarray(X, dtype=np.float32)
        return X @ self.w + self.b
    
