class GradientLinearModel():
    def __init__(self, learning_rate = 0.01, epochs=100, trig=True, batch_size=1000, 
                 regularization='elastic', alpha=0.1, decay_rate=0.99):
        self.learning_rate = learning_rate
        self.w = None
        self.b = None
        self.epochs = epochs
        self.trig = trig
        self.batch_size = batch_size
        self.regularization = regularization
        self.alpha = alpha
        self.decay_rate = decay_rate

    def fit(self, X, y):
        m, n = X.shape
        self.w = np.random.randn(n).astype(np.float32) * 0.01
        self.b = np.zeros(1, dtype=np.float32)
        
        X = np.asarray(X, dtype=np.float32)
        y = np.asarray(y, dtype=np.float32)
        
        current_lr = self.learning_rate

        indices = np.arange(m)

        loss_last = 50000
        loss_list = []
        
        batch_size = self.batch_size

        for epoch in range(self.epochs):
            np.random.shuffle(indices)
            for i in range(0, m, batch_size):
                end_idx = min(i + batch_size, m)
                X_batch = X[indices[i:end_idx]] 

                batch_size_actual = len(X_batch)

                # Сами расчеты градиентного спуска
                y_pred = X_batch @ self.w + self.b
                errors = y_pred - y[indices[i:end_idx]]

                dw = X_batch.T @ errors / batch_size_actual
                db = np.sum(errors) / batch_size_actual

                # Реализациярегулизации
                if self.regularization == 'l2':
                    dw += (self.alpha) * self.w
                elif self.regularization == 'l1':
                    dw += (self.alpha) * np.sign(self.w)
                elif self.regularization == 'elastic':
                    l1_term = (self.alpha * 0.5) * np.sign(self.w)
                    l2_term = (self.alpha * 0.5) * self.w 
                    dw += (l1_term + l2_term)
                    
                # Градиент по весам 
                self.w -= dw * current_lr
                    # Градиент по смещению
                self.b -= db * current_lr

            # Чтобы заранее остановить обучение и поиск w и b
            current_loss = np.mean((X @ self.w + self.b - y) ** 2)
            if abs(loss_last - current_loss) <= 1e-4:
                break
                
            # Показываю обучение, если заранее написать True
            if epoch % 10 == 0 and self.trig:
                print(f'Epoch: {epoch}, w: {self.w}, b: {self.b}, MSE: {round(current_loss, 5)}, Loss: {np.sum(errors)}')

            # Адаптивный learning rate
            if epoch > 0 and epoch % 10 == 0:
                current_lr *= self.decay_rate
                
            loss_last = current_loss
            

    def predict(self, X):
        # Прогнозы лин модели
        X = np.asarray(X, dtype=np.float32)
        return X @ self.w + self.b
    
    def partial_fit(self, X_batch, y_batch):
        # Инкрементальное обучение для потоковых данных
        if self.w is None:
            self.w = np.random.randn(X_batch.shape[1]).astype(np.float32) * 0.01
            self.b = np.zeros(1, dtype=np.float32)

        X_batch = np.asarray(X_batch, dtype=np.float32)
        y_batch = np.asarray(y_batch, dtype=np.float32)

        # Быстрое обновление на одном батче
        y_pred = X_batch @ self.w + self.b
        errors = y_pred - y_batch

        dw = (X_batch.T @ errors) / len(y_batch)
        db = np.sum(errors) / len(y_batch)

        # Применение регуляризации
        if self.regularization == 'l2':
            dw += (self.alpha) * self.w
        elif self.regularization == 'l1':
            dw += (self.alpha) * np.sign(self.w)
        elif self.regularization == 'elastic':
            l1_term = (self.alpha * 0.5) * np.sign(self.w)
            l2_term = (self.alpha * 0.5) * self.w 
            dw += (l1_term + l2_term)

        self.w -= self.learning_rate * dw
        self.b -= self.learning_rate * db

        return self
 

