            axes[1].set_title('Анализ дисперсии',fontweight="normal", color='black')

            plt.grid(True)
            plt.show();

            print("RMSE:", round(rmse, 5))
            print("MSE:", round(mse, 5))
            print("MAE:", round(mae, 5))
            print("R²:", round(r2, 3), end='\n\n')
            
