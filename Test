import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import mean_squared_error, r2_score, mean_absolute_error
import pandas as pd
import warnings
warnings.filterwarnings('ignore')

# Выносим JIT-функции вне класса
@np.vectorize
def fast_sign(x):
    """Быстрая замена np.sign для регуляризации"""
    return 1.0 if x > 0 else (-1.0 if x < 0 else 0.0)

def fast_prediction(X, w, b):
    """Быстрое предсказание без JIT декоратора"""
    return X @ w + b

class OptimizedGradientLinearModel():
    def __init__(self, learning_rate=0.01, epochs=1000, trig=False, batch_size=32, 
                 regularization='elastic', alpha=0.1, early_stopping=True, patience=10,
                 decay_rate=0.99):
        self.learning_rate = learning_rate
        self.w = None
        self.b = None
        self.epochs = epochs
        self.trig = trig
        self.batch_size = batch_size
        self.regularization = regularization
        self.alpha = alpha
        self.early_stopping = early_stopping
        self.patience = patience
        self.decay_rate = decay_rate

    def fit(self, X, y):
        m, n = X.shape
        
        # Оптимизированная инициализация
        self.w = np.random.randn(n).astype(np.float32) * 0.01
        self.b = np.zeros(1, dtype=np.float32)

        # Конвертация в оптимальные типы один раз
        X = np.asarray(X, dtype=np.float32)
        y = np.asarray(y, dtype=np.float32)

        # Автоматическая настройка batch_size для больших данных
        if m > 100000:
            self.batch_size = min(1024, self.batch_size * 4)
        
        loss_list = []
        best_w = self.w.copy()
        best_b = self.b.copy()
        best_loss = float('inf')
        patience_count = 0
        current_lr = self.learning_rate

        # Предварительные вычисления
        indices = np.arange(m)
        
        for epoch in range(self.epochs):
            # Векторизованное перемешивание
            np.random.shuffle(indices)
            X_shuffled = X[indices]
            y_shuffled = y[indices]

            total_batch_loss = 0.0
            batch_count = 0

            for i in range(0, m, self.batch_size):
                end_idx = min(i + self.batch_size, m)
                X_batch = X_shuffled[i:end_idx]
                y_batch = y_shuffled[i:end_idx]
                batch_size_actual = X_batch.shape[0]

                # ОПТИМИЗИРОВАННЫЕ ВЫЧИСЛЕНИЯ
                y_pred = fast_prediction(X_batch, self.w, self.b)
                errors = y_pred - y_batch

                # Векторизованные градиенты
                dw = (X_batch.T @ errors) / batch_size_actual
                db = np.sum(errors) / batch_size_actual

                # Оптимизированная регуляризация
                dw = self._apply_regularization(dw, self.w)

                # Обновление параметров
                self.w -= current_lr * dw
                self.b -= current_lr * db

                total_batch_loss += np.sum(errors ** 2)
                batch_count += batch_size_actual

            # Вычисление общей потери
            current_loss = total_batch_loss / batch_count if batch_count > 0 else 0
            loss_list.append(current_loss)

            # Улучшенная ранняя остановка
            if self.early_stopping:
                if current_loss < best_loss - 1e-7:
                    best_loss = current_loss
                    best_w = self.w.copy()
                    best_b = self.b.copy()
                    patience_count = 0
                else:
                    patience_count += 1

                if patience_count >= self.patience:
                    self.w = best_w
                    self.b = best_b
                    if self.trig:
                        print(f"Early stopping at epoch {epoch}")
                    break

            # Адаптивный learning rate
            if epoch > 0 and epoch % 10 == 0:
                current_lr *= self.decay_rate

            # Улучшенный вывод прогресса
            if self.trig and epoch % 10 == 0:
                print(f'Epoch: {epoch}, MSE: {current_loss:.5f}, LR: {current_lr:.6f}')

        return self

    def _apply_regularization(self, dw, w):
        """Оптимизированная применение регуляризации"""
        if self.regularization == 'l2':
            dw += self.alpha * w
        elif self.regularization == 'l1':
            # Используем векторную версию sign
            dw += self.alpha * fast_sign(w)
        elif self.regularization == 'elastic':
            l1_term = (self.alpha * 0.5) * fast_sign(w)
            l2_term = (self.alpha * 0.5) * w
            dw += l1_term + l2_term
        return dw

    def predict(self, X):
        """Быстрое предсказание без JIT"""
        X = np.asarray(X, dtype=np.float32)
        return fast_prediction(X, self.w, self.b)

    # Альтернативная версия для больших данных с batch processing
    def predict_batch(self, X, batch_size=10000):
        """Предсказание с батч-обработкой для очень больших данных"""
        X = np.asarray(X, dtype=np.float32)
        n_samples = X.shape[0]
        predictions = np.zeros(n_samples, dtype=np.float32)
        
        for i in range(0, n_samples, batch_size):
            end_idx = min(i + batch_size, n_samples)
            X_batch = X[i:end_idx]
            predictions[i:end_idx] = fast_prediction(X_batch, self.w, self.b)
            
        return predictions

    def get_params(self):
        """Возвращает параметры модели"""
        return {'w': self.w, 'b': self.b, 'features': self.w.shape[0]}

    def set_params(self, w, b):
        """Устанавливает параметры модели (для transfer learning)"""
        self.w = w
        self.b = b

    def graph(self, y_test, y_progn):
        """Оптимизированная визуализация"""
        # Быстрые вычисления метрик
        y_test = np.asarray(y_test)
        y_progn = np.asarray(y_progn)
        
        mse = mean_squared_error(y_test, y_progn)
        r2 = r2_score(y_test, y_progn)
        rmse = np.sqrt(mse)
        mae = mean_absolute_error(y_test, y_progn)

        residuls = y_test - y_progn

        # Оптимизированное построение графиков
        fig, axes = plt.subplots(1, 2, figsize=(10, 4))
        
        # Гистограмма с оптимизированными бинами
        n_bins = min(50, len(residuls) // 100)
        axes[0].hist(residuls, bins=n_bins, alpha=0.7, color='skyblue', edgecolor='black')
        axes[0].set_title('Гистограмма распределения остатков', fontsize=12)
        axes[0].set_xlabel('Остатки')
        axes[0].set_ylabel('Частота')
        axes[0].grid(True, alpha=0.3)

        # Scatter plot с оптимизацией для больших данных
        if len(y_progn) > 10000:
            # Сэмплирование для больших данных
            indices = np.random.choice(len(y_progn), size=10000, replace=False)
            axes[1].scatter(y_progn[indices], residuls[indices], alpha=0.5, s=1)
        else:
            axes[1].scatter(y_progn, residuls, alpha=0.6, s=20)
        
        axes[1].axhline(y=0, color='red', linestyle='--', alpha=0.8)
        axes[1].set_xlabel('Предсказания модели')
        axes[1].set_ylabel('Остатки')
        axes[1].set_title('Анализ дисперсии')
        axes[1].grid(True, alpha=0.3)

        plt.tight_layout()
        plt.show()

        # Вывод метрик
        print("=" * 50)
        print("МЕТРИКИ КАЧЕСТВА МОДЕЛИ:")
        print("=" * 50)
        print(f"RMSE: {rmse:.5f}")
        print(f"MSE:  {mse:.5f}")
        print(f"MAE:  {mae:.5f}")
        print(f"R²:   {r2:.4f}")
        print()
        
        # Оптимизированная статистика
        print('ОПИСАТЕЛЬНАЯ СТАТИСТИКА ОШИБОК:')
        print(pd.DataFrame(residuls, columns=['Ошибки']).describe().round(5))

    def partial_fit(self, X_batch, y_batch):
        """Инкрементальное обучение для потоковых данных"""
        if self.w is None:
            self.w = np.random.randn(X_batch.shape[1]).astype(np.float32) * 0.01
            self.b = np.zeros(1, dtype=np.float32)

        X_batch = np.asarray(X_batch, dtype=np.float32)
        y_batch = np.asarray(y_batch, dtype=np.float32)

        # Быстрое обновление на одном батче
        y_pred = fast_prediction(X_batch, self.w, self.b)
        errors = y_pred - y_batch

        dw = (X_batch.T @ errors) / len(y_batch)
        db = np.sum(errors) / len(y_batch)

        # Применение регуляризации
        dw = self._apply_regularization(dw, self.w)

        self.w -= self.learning_rate * dw
        self.b -= self.learning_rate * db

        return self

    def score(self, X, y):
        """Быстрая оценка модели (R² score)"""
        y_pred = self.predict(X)
        return r2_score(y, y_pred)

# Альтернативная: если нужна сверхбыстрая JIT-версия, используйте отдельную функцию
def create_fast_predict_function(w, b):
    """Создает скомпилированную функцию предсказания для данных весов"""
    @jit(nopython=True)
    def fast_predict(X):
        return X @ w + b
    return fast_predict
